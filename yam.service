[Unit]
Description=YAM Lua runtime host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/opt/yam/bin/yam-lua-runtime --data-dir /opt/yam/data
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
